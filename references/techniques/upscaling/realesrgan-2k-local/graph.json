{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "${loadvideo-1}",
      "keep_audio": true,
      "trim_time": "0"
    }
  },
  "2": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "1",
        0
      ]
    }
  },
  "3": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": [
        "2",
        0
      ],
      "batch_index": 0,
      "length": 360
    }
  },
  "4": {
    "class_type": "UpscaleModelLoader",
    "inputs": {
      "model_name": "${n4-model-name}"
    }
  },
  "5": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": {
      "upscale_model": [
        "4",
        0
      ],
      "image": [
        "3",
        0
      ]
    }
  },
  "6": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "8",
        0
      ],
      "fps": 24,
      "codec": "auto",
      "bit_depth": 8,
      "color_space": "sRGB",
      "audio": [
        "2",
        1
      ]
    }
  },
  "7": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "6",
        0
      ],
      "filename_prefix": "${n7-filename-prefix}",
      "format": "auto",
      "codec": "auto",
      "format.codec": "auto"
    }
  },
  "8": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "5",
        0
      ],
      "upscale_method": "area",
      "width": 1440,
      "height": 2560,
      "crop": "disabled"
    }
  }
}
