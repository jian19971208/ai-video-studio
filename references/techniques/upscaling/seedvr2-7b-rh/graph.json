{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "${input-video}",
      "keep_audio": true,
      "trim_time": "0"
    }
  },
  "2": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "1",
        0
      ]
    }
  },
  "3": {
    "class_type": "SeedVR2LoadDiTModel",
    "inputs": {
      "model": "seedvr2_ema_7b_fp16.safetensors",
      "device": "cuda:0",
      "blocks_to_swap": 0,
      "swap_io_components": false,
      "offload_device": "cpu",
      "attention_mode": "sdpa"
    }
  },
  "4": {
    "class_type": "SeedVR2LoadVAEModel",
    "inputs": {
      "model": "ema_vae_fp16.safetensors",
      "device": "cuda:0",
      "encode_tiled": true,
      "encode_tile_size": 1024,
      "encode_tile_overlap": 128,
      "decode_tiled": true,
      "decode_tile_size": 1024,
      "decode_tile_overlap": 128,
      "tile_debug": "false",
      "offload_device": "cpu"
    }
  },
  "5": {
    "class_type": "SeedVR2VideoUpscaler",
    "inputs": {
      "image": [
        "20",
        0
      ],
      "dit": [
        "3",
        0
      ],
      "vae": [
        "4",
        0
      ],
      "seed": 42,
      "resolution": 1440,
      "max_resolution": 2560,
      "batch_size": 5,
      "uniform_batch_size": true,
      "color_correction": "lab",
      "temporal_overlap": 0,
      "prepend_frames": 0,
      "input_noise_scale": 0.0,
      "latent_noise_scale": 0.0,
      "offload_device": "cpu",
      "enable_debug": false
    }
  },
  "6": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "5",
        0
      ],
      "upscale_method": "lanczos",
      "width": 1440,
      "height": 2560,
      "crop": "disabled"
    }
  },
  "7": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "6",
        0
      ],
      "fps": 24,
      "audio": [
        "35",
        0
      ],
      "codec": "auto",
      "bit_depth": 8,
      "color_space": "sRGB"
    }
  },
  "8": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "7",
        0
      ],
      "filename_prefix": "${output-prefix}",
      "format": "auto",
      "codec": "auto",
      "format.codec": "auto"
    }
  },
  "20": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": [
        "2",
        0
      ],
      "batch_index": 0,
      "length": 360
    }
  },
  "35": {
    "class_type": "TrimAudioDuration",
    "inputs": {
      "audio": [
        "2",
        1
      ],
      "start_index": 0,
      "duration": 15
    }
  }
}
