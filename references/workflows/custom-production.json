{
  "schema_version": 1,
  "workflow_kind": "custom-planner",
  "id": "custom-production",
  "name": "自定义制作",
  "version": "2.6.6",
  "status": "candidate",
  "guide": "custom.md",
  "supported_backends": [
    "comfyui",
    "runninghub-native"
  ],
  "inputs": [
    {
      "name": "brief",
      "required": true,
      "description": "用户描述目标；素材可由用户提供或由方案安排获取。"
    },
    {
      "name": "materials",
      "required": false
    }
  ],
  "integration_policy": {
    "selection_scope": "workflow",
    "guide": "integration-selection.md"
  },
  "steps": [
    {
      "id": "select",
      "action": "先确定自建ComfyUI或RH及具名配置；已有本次明确选择直接沿用",
      "references": [
        "integration-selection.md"
      ]
    },
    {
      "id": "discover",
      "action": "核对该接入实际可用模型、规格、收费路线和当前宿主生图能力；只读，不生成测试",
      "references": [
        "../integrations/self-hosted-comfyui.md",
        "../integrations/runninghub.md",
        "../integrations/image-and-materials.md",
        "../integrations/service-capabilities.md"
      ]
    },
    {
      "id": "options",
      "action": "按上下文展示简单方案和相关技巧选项，一次询问制作方向；已有明确选择或直接做指令不重复问，不强加逐项确认",
      "references": [
        "custom.md"
      ]
    },
    {
      "id": "brief",
      "action": "沿用已给目标和素材，只补必要内容、数量和输出位置",
      "references": [
        "custom.md"
      ]
    },
    {
      "id": "plan",
      "action": "读取适用技巧，按本次选择设计文字分镜、节点和提示词；storyboard_images=false时不调用生图或插入图片审定",
      "references": [
        "../techniques/index.md",
        "../techniques/execution.md",
        "../techniques/graphs.md",
        "authoring.md"
      ]
    },
    {
      "id": "storyboard-images",
      "action": "仅storyboard_images=true时提前生成并查看图片分镜；关闭则沿用真实参考图与文字方案",
      "when": {
        "storyboard_images": true
      },
      "references": [
        "../techniques/storyboarding/guide.md",
        "../integrations/image-and-materials.md"
      ]
    },
    {
      "id": "validate",
      "action": "按实际选用步骤核验能力；关闭的图片分镜、超分与审查不列为必需依赖",
      "references": [
        "../preflight.md",
        "../integrations/cli.md",
        "../integrations/runninghub.md"
      ]
    },
    {
      "id": "execute",
      "action": "按授权数量和费用执行；只恢复原任务",
      "references": [
        "../production.md"
      ]
    },
    {
      "id": "review",
      "action": "仅有效配置review=true或用户单独要求审查时执行内容审查与图文报告；关闭时不抽帧、不生成审查报告",
      "references": [
        "../techniques/quality-review/guide.md",
        "../techniques/quality-review/report-format.md"
      ],
      "when": {
        "review": true
      }
    },
    {
      "id": "deliver",
      "action": "默认只交视频与实际请求参数；review=true才附HTML审查报告；超分成功附原片",
      "references": [
        "records.md",
        "../techniques/quality-review/report-format.md"
      ]
    }
  ],
  "execution": "Agent plans then compiles a task-specific execution manifest; this entry itself must never be treated as a ready generation graph",
  "delivery": "自定义制作默认交付成片MP4和实际请求参数JSON；review=true才生成并交付HTML审查报告；超分成功另附原片。下载、文件完整性和可播放性等基本交付检查仍执行，不以此声称内容合格。",
  "selection_policy": {
    "confirm_each_task": true,
    "skip_prompt_user_requested": false,
    "show_supported_backends": true,
    "confirm_before_intake": true
  },
  "default_production": {
    "model": "MiniMax H3",
    "resolution": "768P",
    "aspect_ratio": "9:16",
    "duration_seconds": 15,
    "fps": 24,
    "upscale": false,
    "audio": "preserve-model-original",
    "mode": "REF when suitable references exist; otherwise choose supported mode for the brief",
    "dimension_policy": "Resolve exact width and height from live model/node alignment constraints; do not silently lower resolution or change orientation",
    "apply_when_user_unspecified": true,
    "require_separate_parameter_confirmation": false,
    "long_video_strategy": "recommend-from-content",
    "review": false,
    "storyboard_images": false
  },
  "intake_policy": {
    "order": [
      "select-platform-and-profile",
      "check-platform-models-billing-and-host-tools",
      "show-defaults-and-supported-options",
      "collect-only-missing-creative-inputs",
      "plan-and-execute"
    ],
    "show_options_once": true,
    "ask_only_missing_execution_critical_items": true,
    "billing_route_must_be_disclosed": true,
    "do_not_silently_switch_to_wallet": true,
    "scope": "custom-production only; product-showcase remains a fixed recipe",
    "offer_simple_or_optional_techniques": true,
    "present_relevant_technique_options": true,
    "ask_one_combined_direction_question_when_unspecified": true,
    "do_not_repeat_current_context_choices": true,
    "explicit_simple_or_direct_request_uses_defaults": true,
    "never_enable_optional_steps_only_because_they_are_available": true
  },
  "long_video_options": {
    "segmented_assembly": {
      "guide": "../techniques/editing/guide.md",
      "recommended_for": "multiple scenes"
    },
    "model_reference_continuation": {
      "guide": "../techniques/video-continuation/guide.md",
      "supported_model_family": "MiniMax H3",
      "supported_method": "REF video reference input",
      "execution": "serial continuation then assembly",
      "unlimited_single_generation": false
    },
    "default_selection": "recommend from content unless user specifies"
  },
  "settings_resolution": {
    "precedence": [
      "task_override",
      "saved_custom_defaults",
      "default_production"
    ],
    "storage": "workflows/config.json: workflows.NAME.custom_defaults",
    "separate_parameter_confirmation": false
  },
  "review_policy": {
    "enabled_setting": "review",
    "default": false,
    "when_disabled": "skip content review, frame evidence extraction and HTML report; retain basic download/file/playability verification",
    "when_enabled": "follow quality-review guide and comparison report format",
    "explicit_review_request": "set review=true for this task",
    "do_not_modify_existing_tasks": true
  },
  "technique_options": [
    {
      "id": "storyboard-images",
      "name": "提前生成图片分镜",
      "setting": "storyboard_images",
      "default": false,
      "purpose": "先设计人物、场景和构图，再作为视频参考；多一步生图和查看设计图",
      "guide": "../techniques/storyboarding/guide.md"
    },
    {
      "id": "video-motion-reference",
      "name": "视频动作/运镜参考",
      "default": "only if requested or chosen for relevant brief",
      "purpose": "用已有视频示意动作与镜头，需实际视频参考能力；不自动生成白模",
      "guide": "../techniques/video-reference/guide.md"
    },
    {
      "id": "camera-and-effects",
      "name": "运镜与背景效果",
      "default": "fit current brief",
      "purpose": "可选镜头风格、环境和背景特效，由用户内容决定，不额外强加制作步骤",
      "guide": "../techniques/camera-and-effects/guide.md"
    },
    {
      "id": "long-video",
      "name": "长视频拼接或H3参考续接",
      "default": "only when requested duration needs it",
      "guide": "../techniques/video-continuation/guide.md"
    },
    {
      "id": "upscale",
      "name": "超分提升清晰度",
      "setting": "upscale",
      "default": false,
      "guide": "../techniques/upscaling/guide.md"
    },
    {
      "id": "review",
      "name": "图文质量审查",
      "setting": "review",
      "default": false,
      "guide": "../techniques/quality-review/guide.md"
    }
  ],
  "storyboard_policy": {
    "enabled_setting": "storyboard_images",
    "default": false,
    "must_mention_as_option": true,
    "when_disabled": "Use supplied references and text shot planning; no new storyboard image generation, image approval stage or associated mandatory capability",
    "when_enabled": "Read storyboarding guide, check actual image tool, design and inspect images before video generation",
    "existing_user_images_remain_valid_references": true,
    "scope": "custom-production only"
  }
}
