{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "workflow_kind",
    "guide",
    "supported_backends",
    "steps"
  ],
  "properties": {
    "workflow_kind": {
      "const": "custom-planner"
    },
    "supported_backends": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "comfyui",
          "runninghub-native"
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "action",
          "references"
        ]
      }
    },
    "default_production": {
      "type": "object",
      "required": [
        "model",
        "resolution",
        "duration_seconds",
        "aspect_ratio",
        "upscale",
        "require_separate_parameter_confirmation",
        "review"
      ],
      "properties": {
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "upscale": {
          "type": "boolean"
        },
        "require_separate_parameter_confirmation": {
          "const": false
        },
        "review": {
          "type": "boolean"
        }
      }
    }
  }
}
